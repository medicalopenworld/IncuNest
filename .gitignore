# VSCode
.vscode/
!Firmware/motherBoard/.vscode/c_cpp_properties.json

# PlatformIO / builds
.pio/
**/.pio/
build/
**/build/
.pio/build/
**/.pio/build/
build/
**/build/
**/preproc/
**/includes.cache
*.log
*.map
*.o
*.obj
*.d
*.bin
*.elf
*.hex

# Flasher tool firmware binaries are intentionally tracked
!Firmware/flasher_tool/data/firmware/**/*.bin

# clangd cache (all subprojects)
**/.cache/
# Credentials (nunca versionar)
**/Credentials.h

# Hardware history folders
Hardware/Electronics/Motherboard/History/
# (o más genérico, si quieres ignorar cualquier carpeta History)
# Hardware/**/[Hh]istory/

# Agents and Workspaces
.agent
*.code-workspace
.claude
# Exception: SensorBoard_v2 versions its agentic framework deliberately (claude_agents_tests experiment)
!Firmware/SensorBoard_v2/.claude/
!Firmware/SensorBoard_v2/.claude/**

# Serial capture logs
Firmware/motherBoard/serial_*.txt

# Thingsboard local folder
Firmware/Thingsboard/