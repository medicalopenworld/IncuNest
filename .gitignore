# VSCode
.vscode/
!Firmware/motherBoard/.vscode/c_cpp_properties.json

# PlatformIO / builds
.pio/
**/.pio/
build/
**/build/
.pio/build/
**/.pio/build/
build/
**/build/
**/preproc/
**/includes.cache
*.log
*.map
*.o
*.obj
*.d
*.bin
*.elf
*.hex

# Los binarios de firmware del flasher NO se versionan: se compilan con el
# Credentials.h real (claves de ThingsBoard, del servidor web y de Onomondo) y
# este repositorio es publico, asi que subirlos publica esas claves dentro del
# .bin. El flasher los descarga de GitHub Releases (flasher/updater.py).
# La regla general *.bin de arriba ya los cubre.

# clangd cache (all subprojects)
**/.cache/
# Credentials (nunca versionar)
**/Credentials.h

# Hardware history folders (backups automáticos de Altium, no se versionan)
Hardware/**/[Hh]istory/

# Agents and Workspaces
.agent
*.code-workspace
.claude

# Serial capture logs
Firmware/motherBoard/serial_*.txt

# Thingsboard local folder
Firmware/Thingsboard/

# Git worktrees (superpowers:using-git-worktrees isolated workspaces)
Firmware/.worktrees/

# Documentacion regulatoria local (no versionar)
Regulatory/